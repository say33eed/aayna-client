/* Scoped footer link interaction: does not depend on Tailwind's hover ordering. */
.link,
.link:link,
.link:visited {
  color: var(--muted);
  text-decoration-line: none;
  text-decoration-color: var(--muted);
  text-decoration-thickness: 1px;
  text-underline-offset: 4px;
  border: 0;
  box-shadow: none;
}
.link:hover,
.link:focus-visible {
  color: var(--muted);
  text-decoration-line: underline;
  text-decoration-color: var(--muted);
  border: 0;
  box-shadow: none;
}
